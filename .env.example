# ---- Frontend (web/.env) ----
# URL of the deployed Edge Function. No other keys belong in the frontend.
VITE_API_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/api

# ---- Edge Function secrets (set with: supabase secrets set NAME=value) ----
# Never commit real values. These are listed here for reference only.
# ADMIN_PASSWORD=
# GEMINI_API_KEY=        (optional fallback; normally set from the admin Settings page)
# GEMINI_MODEL=          (optional fallback; default gemini-2.5-flash)
# ALLOWED_ORIGIN=https://your-site.pages.dev
